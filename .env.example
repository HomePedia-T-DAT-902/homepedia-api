POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Mapbox (frontend)
MAPBOX_TOKEN=your_mapbox_token_here
